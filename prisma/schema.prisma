generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStatus {
  NEU
  IN_KLAERUNG
  PO_OFFEN
  MUSTER_OFFEN
  PRODUKTION
  VERSCHIFFT
  VERZOLLUNG_VORBEREITEN
  BEIM_ZOLL
  FREIGEGEBEN
  ABGESCHLOSSEN
  PROBLEM_ROT
}

enum DocumentStatus {
  FEHLT
  ANGEFRAGT
  ERHALTEN
  GEPRUEFT
  NICHT_NOETIG
}

enum WaitTarget {
  INTERN
  LIEFERANT
  SPEDITION
  KUNDE
  ZOLL
  KEIN_BLOCKER
}

enum DealPriority {
  NIEDRIG
  NORMAL
  HOCH
  KRITISCH
}

enum RiskStatus {
  NIEDRIG
  MITTEL
  HOCH
}

model Deal {
  id                     String         @id @default(cuid())
  kunde                  String
  marke                  String?
  artikel                String
  stueckzahl             String?
  preis                  String?
  warenwert              String?
  marge                  String?
  dealnummer             String?
  ausmusterung           String?
  liefertermin           String?
  po                     String?
  drittlandswarePo       String?
  drittlandswareEtd      DateTime?
  drittlandswareEta      DateTime?
  drittlaender           String?
  fotomusterPo           String?
  fotomusterEtd          DateTime?
  fotomusterEta          DateTime?
  qsMusterPo             String?
  qsMusterEtd            DateTime?
  qsMusterEta            DateTime?
  servicewarePo          String?
  servicewareEtd         DateTime?
  servicewareEta         DateTime?
  poMassProductionDone   Boolean        @default(false)
  poDrittlandswareDone   Boolean        @default(false)
  poFotomusterDone       Boolean        @default(false)
  poQsMusterDone         Boolean        @default(false)
  poServicewareDone      Boolean        @default(false)
  etd                    DateTime?
  eta                    DateTime?
  etaUnbekannt           Boolean        @default(false)
  crdZeitfenster         String?
  status                 DealStatus     @default(NEU)
  priority               DealPriority   @default(NORMAL)
  riskStatus             RiskStatus     @default(NIEDRIG)
  wartetAuf              WaitTarget     @default(KEIN_BLOCKER)
  wartetAufNotiz         String?
  naechsterSchritt       String?
  bearbeitenBis          DateTime?
  lieferant              String?
  lieferantKontakt       String?
  spedition              String?
  speditionKontakt       String?
  incoterm               String?
  pol                    String?
  pod                    String?
  containerNummer        String?
  blNummer               String?
  zahlungsstatus         String?
  commercialInvoice      DocumentStatus @default(FEHLT)
  packingList            DocumentStatus @default(FEHLT)
  billOfLading           DocumentStatus @default(FEHLT)
  ursprungsnachweis      DocumentStatus @default(FEHLT)
  hsCode                 DocumentStatus @default(FEHLT)
  ceDokumente            DocumentStatus @default(NICHT_NOETIG)
  pruefberichte          DocumentStatus @default(NICHT_NOETIG)
  dokumentenDrafts       DocumentStatus @default(FEHLT)
  verschiffungspapiere   DocumentStatus @default(FEHLT)
  telexBl                DocumentStatus @default(FEHLT)
  proformaDrittlandsware DocumentStatus @default(FEHLT)
  inspektion100          DocumentStatus @default(FEHLT)
  shipmentRelease        DocumentStatus @default(FEHLT)
  releaseDocument        DocumentStatus @default(FEHLT)
  h1Document             DocumentStatus @default(FEHLT)
  t1Document             DocumentStatus @default(FEHLT)
  entladebericht         DocumentStatus @default(FEHLT)
  notizenKurz            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  notes                  DealNote[]
  changes                DealChange[]
  reminders              DealReminder[]

  @@index([kunde])
  @@index([status])
  @@index([eta])
  @@index([bearbeitenBis])
  @@index([priority])
  @@index([wartetAuf])
}

model DealNote {
  id        String   @id @default(cuid())
  dealId    String
  text      String
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealChange {
  id        String   @id @default(cuid())
  dealId    String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String?
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([createdAt])
}

model DealReminder {
  id           String    @id @default(cuid())
  dealId       String
  systemKey    String?   @unique
  text         String
  dueDate      DateTime
  snoozedUntil DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([dueDate])
  @@index([completedAt])
  @@index([snoozedUntil])
}
